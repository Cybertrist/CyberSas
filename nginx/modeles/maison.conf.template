# maison : un service hébergé à la maison, publié sur Internet.
#
# Le service n'a aucun port ouvert chez lui. Nginx le joint à travers le
# VPN, par son nom MagicDNS, et ne laisse passer que ceux qu'Authelia
# reconnaît, second facteur compris.
server {
    listen 443 ssl;
    http2 on;
    server_name maison.${DOMAINE};
    include /etc/nginx/extraits/tls.conf;
    include /etc/nginx/extraits/authelia-point.conf;

    location / {
        include /etc/nginx/extraits/authelia-verifier.conf;
        include /etc/nginx/extraits/proxy.conf;

        # 100.100.100.100 : le résolveur du VPN, servi par tailscaled.
        resolver 100.100.100.100 valid=30s ipv6=off;
        set $maison http://maison.sas.internal;
        proxy_pass $maison;
    }
}
