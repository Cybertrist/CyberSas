# vpn : l'API de sasd, où les appareils s'inscrivent. Le tunnel lui-même ne
# passe pas par ici : il arrive en UDP, directement sur sasd.
server {
    listen 443 ssl;
    http2 on;
    server_name vpn.${DOMAINE};
    include /etc/nginx/extraits/tls.conf;

    # sasd n'écoute que sur 127.0.0.1 : on partage son espace réseau.
    set $sasd http://127.0.0.1:8080;

    # S'inscrire coûte une vérification de jeton : on limite qui insiste.
    location = /api/v1/connexion {
        limit_req zone=connexion burst=5 nodelay;
        client_max_body_size 16k;
        include /etc/nginx/extraits/proxy.conf;
        proxy_pass $sasd;
    }

    location /api/ {
        client_max_body_size 16k;
        include /etc/nginx/extraits/proxy.conf;
        proxy_pass $sasd;
    }

    location / { return 404; }
}
