# auth : le portail de connexion. Il envoie chez Google, reçoit la
# réponse sur /oauth2/callback, puis ramène la personne là où elle allait.
server {
    listen 443 ssl;
    http2 on;
    server_name auth.${DOMAINE};
    include /etc/nginx/extraits/tls.conf;

    set $oauth2 http://oauth2-proxy:4180;

    # Rien à deviner ici, le mot de passe se tape chez Google. La limite
    # freine seulement qui voudrait faire tourner le portail en boucle.
    location /oauth2/ {
        limit_req zone=connexion burst=10 nodelay;
        include /etc/nginx/extraits/proxy.conf;
        proxy_pass $oauth2;
    }

    location / {
        include /etc/nginx/extraits/proxy.conf;
        proxy_pass $oauth2;
    }
}
