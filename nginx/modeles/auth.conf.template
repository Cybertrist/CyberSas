# auth : le portail Authelia, où l'on s'identifie.
server {
    listen 443 ssl;
    http2 on;
    server_name auth.${DOMAINE};
    include /etc/nginx/extraits/tls.conf;

    set $authelia http://authelia:9091;

    # Les deux points où l'on devine un mot de passe ou un code sont
    # limités. Authelia gèle aussi le compte de son côté, après trois échecs.
    location ~ ^/api/(firstfactor|secondfactor) {
        limit_req zone=connexion burst=5 nodelay;
        include /etc/nginx/extraits/proxy.conf;
        proxy_pass $authelia;
    }

    location / {
        include /etc/nginx/extraits/proxy.conf;
        proxy_pass $authelia;
    }
}
