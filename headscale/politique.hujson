// Qui peut joindre quoi dans le VPN.
//
// Tout ce qui n'est pas autorisé ici est refusé : sans règle, deux
// appareils du même réseau ne se voient pas.
//
// Un utilisateur s'écrit avec un @ final : « tristan@ ». Les groupes
// d'Authelia ne remontent pas jusqu'ici, il faut donc tenir les deux listes
// à jour ensemble. Après une modification :
//   bash scripts/sas.sh politique
{
  "groups": {
    "group:admins": ["tristan@"],
    "group:equipe": ["essai@"]
  },

  // Les étiquettes désignent des machines, pas des personnes. Seuls les
  // admins peuvent inscrire un appareil sous l'une d'elles.
  "tagOwners": {
    "tag:relais": ["group:admins"],
    "tag:maison": ["group:admins"]
  },

  "grants": [
    // Les admins atteignent tout.
    {"src": ["group:admins"], "dst": ["*"], "ip": ["*"]},

    // Chacun atteint ses propres appareils, et rien de ceux des autres.
    {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

    // L'équipe atteint les services web de la maison, pas son SSH.
    {"src": ["group:equipe"], "dst": ["tag:maison"], "ip": ["tcp:80", "tcp:443"]},

    // Le relais du VPS ne sert qu'à publier ces mêmes services.
    {"src": ["tag:relais"], "dst": ["tag:maison"], "ip": ["tcp:80", "tcp:443"]}
  ]
}
