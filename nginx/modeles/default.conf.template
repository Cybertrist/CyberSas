# Réglages communs, et tout ce qui n'est pas un nom connu.
#
# Le modèle porte le nom default.conf : il remplace celui de l'image, qui
# répondrait sinon à n'importe quel nom d'hôte.

# Les noms Docker se résolvent à la requête, pas au démarrage : Nginx
# démarre même si sasd ou oauth2-proxy ne sont pas encore prêts.
resolver 127.0.0.11 valid=10s ipv6=off;

server_tokens off;

# Seul « Upgrade: websocket » est transmis ; tout autre changement de
# protocole est ignoré, et la connexion reste une simple requête HTTP.
map $http_upgrade $upgrade_accepte {
    default          "";
    "~*^websocket$"  "websocket";
}
map $upgrade_accepte $connection_upgrade {
    default  "upgrade";
    ""       "";
}

# Le cookie de session d'oauth2-proxy ne doit pas partir vers les services
# publiés : c'est un laissez-passer valable douze heures sur tout le
# domaine, qu'un service bavard ou compromis pourrait rejouer ailleurs. Deux
# passes, pour la session et sa suite éventuelle (_oauth2_proxy_1).
map $http_cookie $cookie_sans_session_1 {
    default  $http_cookie;
    "~^(?<avant>.*?)(?:;\s*)?_oauth2_proxy=[^;]*(?<apres>.*)$"  "$avant$apres";
}
map $cookie_sans_session_1 $cookie_sans_session {
    default  $cookie_sans_session_1;
    "~^(?<avant>.*?)(?:;\s*)?_oauth2_proxy_1=[^;]*(?<apres>.*)$"  "$avant$apres";
}

# Un journal par ligne, en JSON : prêt à partir vers un SIEM. L'utilisateur
# est l'adresse Google reconnue, vide sur les pages non protégées.
log_format sas escape=json '{"date":"$time_iso8601","ip":"$remote_addr",'
    '"hote":"$host","methode":"$request_method","uri":"$request_uri",'
    '"statut":$status,"octets":$body_bytes_sent,"duree":$request_time,'
    '"utilisateur":"$sas_utilisateur","agent":"$http_user_agent"}';
access_log /var/log/nginx/acces.json sas;
error_log  /var/log/nginx/erreurs.log warn;

# Dix tentatives de connexion par minute et par adresse, pas plus.
limit_req_zone $binary_remote_addr zone=connexion:10m rate=10r/m;
limit_req_status 429;

# Nom inconnu : on coupe sans répondre, et sans montrer de certificat.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

# En clair, on ne fait que rediriger.
server {
    listen 80;
    server_name ${DOMAINE} *.${DOMAINE};

    location / { return 301 https://$host$request_uri; }
}
