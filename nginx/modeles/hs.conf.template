# hs : le serveur de coordination du VPN.
#
# Les clients Tailscale ouvrent une connexion longue, montée en POST avec
# l'en-tête Upgrade: tailscale-control-protocol. Le relais DERP passe par
# le même chemin, sous /derp. D'où les en-têtes Upgrade transmis tels quels
# et les délais d'une heure.
server {
    listen 443 ssl;
    http2 on;
    server_name hs.${DOMAINE};
    include /etc/nginx/extraits/tls.conf;

    location / {
        set $headscale http://headscale:8080;
        proxy_pass $headscale;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
