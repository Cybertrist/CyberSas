# Copier en .env, puis : bash scripts/sas.sh init

# Le domaine sous lequel tout est servi : hs., auth., maison.
# 127.0.0.1.nip.io est un vrai domaine public qui pointe vers la machine
# locale : Google l'accepte comme adresse de retour, ce qu'il refuse pour
# un nom en .test ou .local.
DOMAINE=127.0.0.1.nip.io

# labo : une autorité locale signe le certificat. Il faudra l'installer sur
# les appareils qui se connectent. Avec un vrai domaine, Let's Encrypt
# prendra le relais (à venir).
TLS=labo

# Le compte Google du premier admin, inscrit par init.
ADMIN_EMAIL=prenom.nom@gmail.com

# Si 80 ou 443 sont déjà pris sur la machine du labo.
PORT_HTTP=80
PORT_HTTPS=443
